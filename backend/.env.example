# Copy to backend/.env (gitignored). Never commit the real key: OpenRouter disables leaked keys.
OPENROUTER_API_KEY=
# 1 = canned verdicts, no network (dev, tests, on-stage backup)
MOCK_LLM=1
# Optional overrides
# ORDER_CHECK_MODEL=google/gemini-3.5-flash
# ORDER_CHECK_FALLBACK_MODEL=anthropic/claude-haiku-5.5
# ORDER_CHECK_TIMEOUT_S=10
# ORDER_CHECK_REASONING=low   (empty to omit the reasoning parameter)
# FRONTEND_ORIGIN=http://localhost:5173
# PORT=5000
